import numpy as np
import pandas as pd
import os
import yaml
from ultralytics import YOLO
# --- 1. paths ---
dataset_root = "datasets"
model_path = "best.pt"
working_dir = "/kaggle/working/"

print("🔍 Folder inspection...")

def find_img_path(root, key):
    for r, dirs, files in os.walk(root):
        if any(f.lower().endswith(('.png', '.jpg', '.jpeg')) for f in files) and key in r.lower():
            return r
    return None

test_images = find_img_path(dataset_root, "test")
val_images = find_img_path(dataset_root, "valid") or find_img_path(dataset_root, "val") or test_images

if not test_images:
    print("❌ Error: No images were found.")
else:
    # --- 2. load models and predict (Predict) ---
    model = YOLO(model_path)
    print("📸 Images are being processed and generated. (Predict)...")
    
    model.predict(
        source=test_images,
        conf=0.25,
        save=True,
        save_txt=True,
        name='construction_predictions' #   images
    )

    # --- 3.    YAML file ---
    try:
        with open(os.path.join(dataset_root, "data.yaml"), 'r') as f:
            orig_yaml = yaml.safe_load(f)
    except:
        orig_yaml = {'nc': 3, 'names': ['Class0', 'Class1', 'Class2']}

    temp_yaml_path = os.path.join(working_dir, "research_config.yaml")
    with open(temp_yaml_path, 'w') as f:
        yaml.dump({
            'path': dataset_root,
            'train': test_images,
            'val': val_images,
            'test': test_images,
            'nc': orig_yaml['nc'],
            'names': orig_yaml['names']
        }, f)

    # --- 4.  (Validation) extract the curves ---
    print("📊   extracting the corrected PR curve. ...")
    metrics = model.val(data=temp_yaml_path, split="test", imgsz=640)

    # --- 5. corrected PR data extraction function    ---
    def save_final_pr_data(val_metrics, output_name="final_correct_pr_curve.csv"):
        #   PR  (X=Recall, Y=Precision)
        target_curve = next((c for c in val_metrics.curves_results if 'Recall' in c[2] and 'Precision' in c[3]), None)
        
        if target_curve:
            x_recall = np.array(target_curve[0]).flatten()
            y_precision = np.array(target_curve[1])
            
            df = pd.DataFrame({'Recall': x_recall})
            names = val_metrics.names
            
            # Link each class to its data based
            for idx, name in names.items():
                if idx < y_precision.shape[0]:
                    df[f"Class_{name}"] = y_precision[idx]
            
            # Mean (All Classes)
            if y_precision.shape[0] > len(names):
                df["All_Classes_Mean"] = y_precision[-1]
            else:
                df["All_Classes_Mean"] = y_precision[:len(names)].mean(axis=0)
                
            df.to_csv(os.path.join(working_dir, output_name), index=False)
            return True
        return False

    if save_final_pr_data(metrics):
        print(f"\n{'='*50}")
        print(f"✅ Done!")
        print(f"📍 Predicted images: {working_dir}runs/detect/construction_predictions")
        print(f"📂 Results file: {working_dir}final_correct_pr_curve.csv")
        print(f"📈 mAP50: {metrics.box.map50:.4f}")
        print(f"{'='*50}")
    else:
        print("⚠️ error extracting the CSV file..")


