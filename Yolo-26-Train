)

for model_name in MODELS:
    print(f"\n{'='*60}")
    print(f"Training {model_name}")
    print(f"{'='*60}\n")

    run_name = model_name.replace('.pt', '')
    model = YOLO(model_name)
    model.train(project="phase1_runs", name=run_name, **TRAIN_ARGS)

    metrics = model.val(project="phase1_runs", name=f"{run_name}_val")
    export_pr_curve_to_csv(metrics, f"{model_name}_validation")

    run_dir = f"runs/detect/phase1_runs/{run_name}"
    
    all_results = load_results()
    
    all_results[model_name] = {
        "mAP50":     round(metrics.box.map50, 4),
        "mAP50-95":  round(metrics.box.map, 4),
        "precision": round(metrics.box.mp, 4),
        "recall":    round(metrics.box.mr, 4),
        "run_name":  run_name,
    }
    save_results(all_results)
