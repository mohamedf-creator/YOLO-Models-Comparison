def export_pr_curve_to_csv(results, output_name, output_folder="PR_Curve_data"):
    """
    Export YOLO PR curve data to a CSV file.

    Args:
        results: YOLO results object returned from model.val() or model.train()
        output_name (str): Name of the CSV file (without extension)
        output_folder (str): Folder to save the CSV into
    """

    # 1. Extract PR curve data
    recall = results.curves_results[0][0]
    precision_matrix = results.curves_results[0][1]
    class_names = results.names
    num_classes = len(class_names)

    # 2. Build dictionary starting with Recall
    data_dict = {"Recall": recall}

    # 3. Add Precision for each class
    for i in range(num_classes):
        class_name = class_names[i].capitalize()
        data_dict[f"Precision_{class_name}"] = precision_matrix[i, :]

    # 4. Add mean precision across classes
    mean_precision = precision_matrix[:num_classes, :].mean(axis=0)
    data_dict["Precision_All_Classes"] = mean_precision

    # 5. Create DataFrame
    df = pd.DataFrame(data_dict)

    # 6. Save CSV
    os.makedirs(output_folder, exist_ok=True)
    csv_path = os.path.join(output_folder, f"{output_name}.csv")
    df.to_csv(csv_path, index=False)

    print(f"✅ PR data saved to: {csv_path}")
