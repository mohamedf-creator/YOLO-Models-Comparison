TRAIN_ARGS = dict(
    data="/kaggle/input/datasets/mohamed111111/multidata", epochs=150, imgsz=640, device="0,1", batch=28,
    mosaic=0.0, mixup=0.0, copy_paste=0.0, cutmix=0.0,
