def make_yaml(base_yaml, train_img, val_img, out_yaml):
    cfg = yaml.safe_load(open(base_yaml))
    cfg['train'] = str(Path(train_img).resolve())
    cfg['val']   = str(Path(val_img).resolve())
    yaml.dump(cfg, open(out_yaml, 'w'))
    print("YAML saved:", out_yaml)
